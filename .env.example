# Optional: docker compose up works without copying this file.
# Only the web service is exposed on the host.
WEB_PORT=8080

# PostgreSQL container. If credentials change, also update DATABASE_URL.
POSTGRES_USER=credit
POSTGRES_PASSWORD=credit
POSTGRES_DB=credit
# SQLAlchemy URL inside the Compose network.
DATABASE_URL=postgresql+psycopg://credit:credit@db:5432/credit

# Local synthetic demo defaults; replace JWT_SECRET before deployment.
JWT_SECRET=local-demo-secret-change-before-deployment
JWT_TTL_HOURS=8
DEMO_MODE=true
# Shared password for future demo accounts; the scaffold creates no accounts.
DEMO_PASSWORD=demo2026
MOCKS_URL=http://mocks:8001/mock/v1
LOG_LEVEL=INFO

