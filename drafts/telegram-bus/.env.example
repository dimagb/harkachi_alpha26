# Настройки хаба (копия в tools/agentbus/.env, не коммитить)
BUS_AGENTS=lead,backend,frontend,ml,ops
BUS_LEAD=lead
# 127.0.0.1 — все агенты на этой машине; 0.0.0.0 — агенты с других машин (тогда BUS_TOKEN обязателен)
BUS_BIND=127.0.0.1
BUS_PORT=8787
BUS_TOKEN=замените-на-длинную-случайную-строку

# Главный бот: читает группу. У @BotFather: /setprivacy -> Disable. Сделайте его админом (нужно для закрепа доски).
TG_BOT_TOKEN=
# id группы (узнать: написать /chatid в группе при запущенном хабе)
TG_CHAT_ID=
# через запятую user_id людей команды; пусто — принимать от всех участников группы
TG_ALLOWED_USER_IDS=
# Необязательно: личные боты агентов — сообщения в чате идут от «Backend», «Frontend» и т. д.
# Создайте у @BotFather по боту на агента и добавьте их в группу. Без этого — подпись [BACKEND] от главного бота.
TG_AGENT_BOTS={"lead":"","backend":"","frontend":"","ml":"","ops":""}
# Необязательно: темы супергруппы с форумом {"general":1,"lead":2,"backend":3,"frontend":4,"ml":5,"ops":6}
TG_TOPICS={}
# Закреплённая доска прогресса (1 — вкл.), не чаще чем раз в N секунд
TG_BOARD=1
TG_BOARD_INTERVAL=30
