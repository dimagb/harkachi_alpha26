# Копия в корне своего клона: .agentbus.env (не коммитить). У каждого агента свой AGENT_ID.
# lead | backend | frontend | ml | ops
AGENT_ID=backend
HUB_URL=http://127.0.0.1:8787
BUS_TOKEN=тот-же-что-в-tools/agentbus/.env

# Как часто хук проверяет срочное посреди работы, секунд (сообщения людей, блокеры, ответы, решения)
AGENTBUS_POLL_SEC=45
# Дежурный режим: сколько секунд агент после завершения хода ждёт новых адресных сообщений.
# Пришло — продолжает работу сам. 0 — выключено (агент просто останавливается).
# Пока хук ждёт, токены не тратятся. Прервать ожидание в терминале: Esc.
# Исполнителям: 1800. Тимлиду, с которым вы говорите в терминале: 0 (иначе после каждого ответа он ждёт Telegram).
AGENTBUS_IDLE_WAIT=1800
