meta {
  name: Ошибка: очередь недоступна клиенту
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/underwriting/queue
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token_ip_good}}
}

tests {
  test("HTTP 403", function () {
    expect(res.getStatus()).to.equal(403);
  });

  test("Ошибка FORBIDDEN", function () {
    expect(res.getBody().error.code).to.equal("FORBIDDEN");
  });
}
