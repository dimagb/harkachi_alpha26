meta {
  name: ИП: ожидание выдачи
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/applications/{{app_ip_good}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token_ip_good}}
}

script:pre-request {
  const remaining = bru.getVar("ip_good_disbursement_deadline") - Date.now();
  req.setTimeout(Math.max(1, Math.min(5000, remaining)));
}

script:post-response {
  const pending = ["SIGNING","SIGNED"];
  const remaining = bru.getVar("ip_good_disbursement_deadline") - Date.now();
  const repeat = res.getStatus() === 200 && pending.includes(res.getBody().state) && remaining > 1000;
  bru.setVar("ip_good_disbursement_deadline_repeat", repeat);
  if (repeat) {
    await bru.sleep(1000);
    bru.runner.setNextRequest(req.getName());
  }
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  if (!bru.getVar("ip_good_disbursement_deadline_repeat")) {
    test("Конечное состояние: DISBURSED", function () {
    expect(res.getBody().state).to.equal("DISBURSED");
    expect(Date.now()).to.be.at.most(bru.getVar("ip_good_disbursement_deadline"));
  });
  test("Условия оферты совпадают с эталоном", function () {
    const offer = res.getBody().offer;
    expect(offer).to.be.an("object");
    expect(offer.amount).to.equal(1500000);
    expect(offer.term_months).to.equal(24);
    expect(offer.rate).to.equal(22);
    expect(offer.monthly_payment).to.equal(77817);
  });
  test("Выдача завершена", function () {
    expect(res.getBody().allowed_actions).to.include("NEW_APPLICATION");
    expect(res.getBody().parties.filter(p => p.is_me).every(p => p.signed)).to.equal(true);
  });
  }
}
