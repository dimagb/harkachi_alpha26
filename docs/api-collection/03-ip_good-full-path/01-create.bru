meta {
  name: Создать заявку: ip_good
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/applications
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token_ip_good}}
  Content-Type: application/json
}

body:json {
  {
    "company_id": "{{company_ip_good}}",
    "product_code": "EXPRESS",
    "amount": 1500000,
    "term_months": 24,
    "purpose": "WORKING_CAPITAL",
    "declared_revenue_year": 14000000
  }
}

script:post-response {
  if (res.getStatus() === 200) bru.setVar("app_ip_good", res.getBody().id);
}

tests {
  test("HTTP 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("Создан новый черновик", function () {
    expect(res.getBody().state).to.equal("DRAFT");
    expect(res.getBody().id).to.be.a("string").and.not.empty;
  });
}
